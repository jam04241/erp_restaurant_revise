<Window x:Class="practice.Landing_Page.Mainpage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practice.Landing_Page"
        mc:Ignorable="d"
        Title="Restaurant Management System" Height="985" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Background='#FF051821' Height="950" Width="1200">
        <!--DEFINE GRID COLUMNS-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION MENU -->
        <Border Grid.Column="0" Background="#FF1A4645" BorderBrush="#FF28666E" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <Border Grid.Row="0" Background="#FF0D2D2C" Padding="20" BorderBrush="#FF28666E" BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Center">
                        <Image MaxHeight="80" Source="/Assets/Daydongs.png" Stretch="Uniform"/>
                        <TextBlock Text="RESTAURANT MANAGEMENT" 
                                  Foreground="White" FontSize="12" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Margin="0,10,0,0"
                                  TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <!-- Dashboard -->
                        <Button x:Name="DashboardBtn" Content="📊 DASHBOARD" Height="50" 
                                HorizontalContentAlignment="Left" Padding="20,0,0,0" 
                                Background="Transparent" Foreground="White" 
                                FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold" 
                                BorderThickness="0" Click="DashboardBtn_Click"/>

                        <Rectangle Height="1" Fill="#FF28666E" Margin="10,0,10,0"/>

                        <!-- Employee Section -->
                        <Button x:Name="EmployeeBtn" Content="👥 EMPLOYEE" Height="50" 
                                HorizontalContentAlignment="Left" Padding="20,0,0,0" 
                                Background="Transparent" Foreground="White" 
                                FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold" 
                                BorderThickness="0" Click="EmployeeBtn_Click"/>

                        <!-- Employee Submenu -->
                        <StackPanel x:Name="employeePanel" Visibility="Collapsed" Background="#FF0D2D2C">
                            <Button x:Name="empaddBtn" Content="➕ Add Employee" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="empaddBtn_Click"/>
                            <Button x:Name="empmanagedBtn" Content="📋 Employee Records" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="empmanagedBtn_Click"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#FF28666E" Margin="10,0,10,0"/>

                        <!-- Attendance Section -->
                        <Button x:Name="AttendanceBtn" Content="📅 ATTENDANCE" Height="50" 
                                HorizontalContentAlignment="Left" Padding="20,0,0,0" 
                                Foreground="White" Background="Transparent" 
                                FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" 
                                BorderThickness="0" Click="AttendanceBtn_Click"/>

                        <!-- Attendance Submenu -->
                        <StackPanel x:Name="attendancePanel" Visibility="Collapsed" Background="#FF0D2D2C">
                            <Button x:Name="createAttendanceBtn" Content="🕐 Daily Attendance" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="createAttendanceBtn_Click"/>
                            <Button x:Name="attendanceRecordsBtn" Content="📊 Attendance Records" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="attendanceRecordsBtn_Click"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#FF28666E" Margin="10,0,10,0"/>

                        <!-- Payroll Section -->
                        <Button x:Name="PayrollBtn" Content="💰 PAYROLL" Height="50" 
                                HorizontalContentAlignment="Left" Padding="20,0,0,0" 
                                Foreground="White" Background="Transparent" 
                                FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" 
                                BorderThickness="0" Click="PayrollBtn_Click"/>

                        <!-- Payroll Submenu -->
                        <StackPanel x:Name="payrollPanel" Visibility="Collapsed" Background="#FF0D2D2C">
                            <Button x:Name="payrollEmployeeSalaryBtn" Content="💵 Employee Salary" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="payrollEmployeeSalaryBtn_Click"/>
                            <Button x:Name="payrollSalaryRecordsBtn" Content="📈 Salary Records" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="payrollSalaryRecordsBtn_Click"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#FF28666E" Margin="10,0,10,0"/>

                        <!-- Customer Management Section -->
                        <Button x:Name="CustomermanageBtn" Content="👥 CUSTOMER MANAGEMENT" Height="50" 
                                HorizontalContentAlignment="Left" Padding="20,0,0,0" 
                                Foreground="White" Background="Transparent" 
                                FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" 
                                BorderThickness="0" Click="CustomerManageBtn_Click"/>

                        <!-- Customer Management Submenu -->
                        <StackPanel x:Name="customerManagePanel" Visibility="Collapsed" Background="#FF0D2D2C">
                            <Button x:Name="customerReservationBtn" Content="🍽️ Customer Reservation" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="customerReservationBtn_Click"/>
                            <Button x:Name="reservationRecordsBtn" Content="📋 Reservation Records" Height="40" 
                                    Padding="40,0,0,0" HorizontalContentAlignment="Left" 
                                    Background="Transparent" Foreground="#FFAAAAAA" 
                                    FontFamily="Segoe UI" FontSize="13" BorderThickness="0" 
                                    Click="reservationRecordsBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout Button -->
                <Border Grid.Row="2" Background="#FF0D2D2C" Padding="15" BorderBrush="#FF28666E" BorderThickness="0,1,0,0">
                    <Button x:Name="LogoutBtn" Content="🚪 LOGOUT" Height="45" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                            Foreground="White" Background="#FFDC2E2E" 
                            FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" 
                            BorderThickness="0" Click="LogoutBtn_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFC62828"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="0">
            <Frame Name="Navigate_Panel" NavigationUIVisibility="Hidden" 
                   Background="Transparent" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>