<Page x:Class="practice.Pages.EmpPayroll"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="EmpPayroll"
      d:DesignHeight="900" d:DesignWidth="900">

    <Grid Background="#FF051821">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="700"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Width="900">
            <Label Content="Employee Payroll" HorizontalAlignment="Left" Margin="88,10,0,0" VerticalAlignment="Top"
                   Foreground="White" FontSize="18" FontWeight="Bold"/>

            <!-- Employee selection -->
            <ComboBox x:Name="employeeComboBox"
          HorizontalAlignment="Left"
          Margin="88,50,0,0"
          VerticalAlignment="Top"
          Width="230"
          Height="28"
          DisplayMemberPath="FullName"
          SelectedValuePath="EmployeeID"/>

            <!-- Date pickers -->
            <DatePicker x:Name="startDatePicker" HorizontalAlignment="Left" Margin="340,50,0,0"
                        VerticalAlignment="Top" Width="150" />
            <DatePicker x:Name="endDatePicker" HorizontalAlignment="Left" Margin="510,50,0,0"
                        VerticalAlignment="Top" Width="150" />

            <!-- Generate button -->
            <Button Content="Generate Payroll" HorizontalAlignment="Left" Margin="680,50,0,0" VerticalAlignment="Top"
                    Width="150" Height="28" Background="#FF7DD22C" Foreground="White"
                    Click="GeneratePayroll_Click"/>

            <!-- Payroll Details -->
            <StackPanel Margin="88,110,112,37" Width="700">
                <DataGrid x:Name="payrollDataGrid" Height="500" AutoGenerateColumns="False"
          Foreground="Black" Background="White" AlternatingRowBackground="#FFE5E5E5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Payroll ID" Binding="{Binding PayrollID}" Width="80"/>
                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}" Width="150"/>
                        <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHours}" Width="100"/>
                        <DataGridTextColumn Header="Basic Pay" Binding="{Binding BasicPay, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Overtime Pay" Binding="{Binding OvertimePay, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Deduction" Binding="{Binding Deduction, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Date Issued" Binding="{Binding DateIssued, StringFormat=yyyy-MM-dd}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
