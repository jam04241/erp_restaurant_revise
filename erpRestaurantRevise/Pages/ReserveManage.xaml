<Page x:Class="practice.Pages.ReserveManage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:practice.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="900"
      Title="ReserveManage">

    <Grid Background="#FF051821">
        <!-- Search -->
        <TextBox HorizontalAlignment="Left" Margin="74,117,0,0" TextWrapping="Wrap" Text="Search" VerticalAlignment="Top" Width="209" Height="33" Background="White"/>

        <!-- Available Tables Panel -->
        <Grid Width="300" Margin="558,169,42,615" Background="#FF1A4645">
            <Label Content="Available Tables" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" FontSize="18" Margin="0,10,0,0"/>
            <Label x:Name="AvailableTablesLabel" Content="20/50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="50" Width="144" Height="82"/>
        </Grid>

        <!-- Pending Reservations -->
        <StackPanel Margin="558,309,42,341" Background="#FF1A4645">
            <Label Content="Pending Reservations" Foreground="White" FontSize="18" Margin="10"/>
            <ItemsControl x:Name="PendingReservationsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel Height="41" Width="300" Margin="16,5,16,0" Background="#FF328C86">
                            <TextBlock Width="10"/>
                            <Label Content="{Binding Customer.FirstName}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Width="10"/>
                            <Button Content="Confirm" Background="#FF7DD22C" Margin="0,0,0,0"
                        Tag="{Binding}" Click="ConfirmReservation_Click"/>
                            <Button Content="Cancel" Background="#FFCA0B0B" Foreground="White" Margin="5,0,0,0"
                        Tag="{Binding}" Click="CancelPendingReservation_Click"/>
                        </WrapPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Confirmed Reservations -->
        <StackPanel x:Name="ConfirmedReservationsList" Margin="74,169,370,338" Background="#FF1A4645">
            <Label Content="Confirmed Reservations" Foreground="White" FontSize="18" Margin="10"/>
            <DataGrid x:Name="ConfirmedReservationsGrid" AutoGenerateColumns="False" Height="322" HeadersVisibility="Column" IsReadOnly="True" 
                      RowHeight="35" CanUserResizeColumns="True" ColumnWidth="*" HorizontalScrollBarVisibility="Auto" Margin="20,0,20,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="80"/>
                    <DataGridTextColumn Header="Table" Binding="{Binding Table.TableNumber}" Width="80"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ReservationDate}" Width="80"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeReserve}" Width="80"/>
                    <DataGridTemplateColumn Header="Actions" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Width="70" Height="25" Background="#FF1E90FF" Foreground="White" FontWeight="Bold"
                                            Tag="{Binding}" Click="EditReservation_Click"/>
                                    <Button Content="Done" Width="70" Height="25" Background="Green" Foreground="White" FontWeight="Bold"
                                            Tag="{Binding}" Click="DoneReservation_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <Button x:Name="addCustomerBtn" Content="Add Customer" HorizontalAlignment="Left" Margin="558,117,0,0" VerticalAlignment="Top" Height="33" Width="150" Foreground="White" Background="#FF17B70A" FontSize="16" Click="addCustomerBtn_Click"/>
        <Button x:Name="addTableBtn" Content="Create Tables" HorizontalAlignment="Left" Margin="724,117,0,0" VerticalAlignment="Top" Height="33" Width="139" Foreground="White" Background="#FF17B70A" FontSize="16" Click="addTableBtn_Click"/>
        <Button x:Name="searchBtn" Content="Search" HorizontalAlignment="Left" Margin="302,117,0,0" VerticalAlignment="Top" Height="33" Width="90" Foreground="White" Background="#FF1A4645" FontSize="16" Click="addCustomerBtn_Click"/>
    </Grid>
</Page>
