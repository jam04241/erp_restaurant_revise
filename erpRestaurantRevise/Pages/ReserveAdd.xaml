<Page x:Class="practice.Pages.ReserveAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:practice.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="900"
      Title="Add Reservation">

    <Grid Background="#FF051821">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF0A2236" Margin="20,10,20,10" CornerRadius="10">
            <Grid>
                <Button x:Name="backBtn" Content="← Back" HorizontalAlignment="Left" Margin="15,0,0,0" 
                        VerticalAlignment="Center" Height="35" Width="100" Click="backBtn_Click" 
                        Background="Transparent" BorderBrush="#FF4A9EFF" BorderThickness="2"
                        Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1E4976"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="ADD CUSTOMER RESERVATION" Foreground="White" FontSize="20" 
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Sitka Small"/>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Margin="50,1,50,39" Background="#FF28666E" CornerRadius="15">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Form Title -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Customer Information" 
                          Foreground="White" FontSize="18" FontWeight="Bold" FontFamily="Sitka Small"
                          HorizontalAlignment="Center" Margin="0,20,0,30"/>

                <!-- Left Column - Personal Information -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <!-- First Name -->
                    <TextBlock Text="First Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,0,0,5"/>
                    <TextBox x:Name="firstnameField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>

                    <!-- Middle Name -->
                    <TextBlock Text="Middle Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,15,0,5"/>
                    <TextBox x:Name="middlenameField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>

                    <!-- Email -->
                    <TextBlock Text="Email *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,15,0,5"/>
                    <TextBox x:Name="emailField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>
                </StackPanel>

                <!-- Right Column - Contact & Reservation Details -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,0">
                    <!-- Last Name -->
                    <TextBlock Text="Last Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,0,0,5"/>
                    <TextBox x:Name="lastnameField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>

                    <!-- Contact No -->
                    <TextBlock Text="Contact No. *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,15,0,5"/>
                    <TextBox x:Name="contactField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>

                    <!-- Number of Guests -->
                    <TextBlock Text="Number of Guests *" Foreground="White" FontSize="14" FontWeight="Bold" 
                              FontFamily="Sitka Small" Margin="0,15,0,5"/>
                    <TextBox x:Name="guestField" Height="35" Background="#FF1A4D54" 
                            Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Padding="10" FontSize="14" CaretBrush="White"/>
                </StackPanel>

                <!-- Reservation Details Section -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#FF1A4D54" 
                       CornerRadius="10" Margin="0,234,0,176" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Reservation Details" 
                                  Foreground="White" FontSize="16" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Date Reserve -->
                        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Date Reserve *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                      FontFamily="Sitka Small" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <DatePicker x:Name="datePicker" Height="35" Width="200" 
                                       Background="#FF28666E" Foreground="Black"
                                       BorderBrush="#FF4A9EFF" BorderThickness="1"
                                       SelectedDate="{x:Static sys:DateTime.Now}"
                                       FontSize="14"/>
                        </StackPanel>

                        <!-- Time Reserve (Military Time) -->
                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Time Reserve (24h) *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                      FontFamily="Sitka Small" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                            <Grid Width="150" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Hours (00-23) -->
                                <ComboBox x:Name="hourComboBox" Grid.Column="0" Height="35"
                                         Background="#FF28666E" Foreground="Black"
                                         BorderBrush="#FF4A9EFF" BorderThickness="1,1,0,1"
                                         FontSize="14" Padding="5"
                                         SelectedIndex="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="Black" Padding="5" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Separator -->
                                <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold"/>

                                <!-- Minutes (00, 15, 30, 45) -->
                                <ComboBox x:Name="minuteComboBox" Grid.Column="2" Height="35"
                                         Background="#FF28666E" Foreground="Black"
                                         BorderBrush="#FF4A9EFF" BorderThickness="0,1,1,1"
                                         FontSize="14" Padding="5"
                                         SelectedIndex="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="black" Padding="5" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Format: HH:MM (24-hour)" Foreground="#FFAAAAAA" FontSize="10" 
                                      FontStyle="Italic" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Submit Button -->
                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="submitBtn" Content="SUBMIT RESERVATION" 
                                   Width="200" Height="45" Background="#FF4CAF50" 
                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                   FontFamily="Sitka Small" Click="submitBtn_Click"
                                   BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF45A049"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF0A2236" Margin="20,10,20,10" CornerRadius="10">
            <TextBlock Text="Fill in all required fields (*) to create a new reservation. Time is in 24-hour format." 
                      Foreground="#FFAAAAAA" FontSize="12" FontStyle="Italic"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>