<Page x:Class="practice.Pages.EmpAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:practice.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="900"
      Title="Add Employee">

    <Grid Background="#FF051821">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF0A2236" Margin="20,10,20,10" CornerRadius="10">
            <Grid>
                <TextBlock Text="ADD EMPLOYEE" Foreground="White" FontSize="20" 
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Sitka Small"/>
            </Grid>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1" Margin="50,20,50,20" Background="#FF1A4645" CornerRadius="15">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <Grid Margin="40" Width="700">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Title -->
                    <TextBlock Grid.Row="0" Text="Employee Information" 
                              Foreground="White" FontSize="18" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,-2,0,32"/>

                    <!-- Personal Information Section -->
                    <Border Grid.Row="1" Background="#FF0D2D2C" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Section Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Personal Information" 
                                      Foreground="White" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <!-- First Name -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="First Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="firstnameField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Middle Name -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Middle Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="middlenameField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Last Name -->
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="Last Name *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="lastnameField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Contact No -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,15,0,0">
                                <TextBlock Text="Contact No. *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="contactField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,15,0,0">
                                <TextBlock Text="Email *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="emailField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status & Personal Details Section -->
                    <Border Grid.Row="2" Background="#FF0D2D2C" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Section Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Personal Details" 
                                      Foreground="White" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <!-- Status -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Status *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <ComboBox x:Name="statusComboBox" Height="38" Background="#FF28666E" 
                                         Foreground="Black" BorderThickness="1"
                                         FontSize="14" Padding="5">
                                    <ComboBoxItem Content="Single" Foreground="Black"/>
                                    <ComboBoxItem Content="Married" Foreground="Black"/>
                                    <ComboBoxItem Content="Widowed" Foreground="Black"/>
                                    <ComboBoxItem Content="Complicated" Foreground="Black"/>
                                    <ComboBoxItem Content="Others" Foreground="Black"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Sex -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Sex *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <ComboBox x:Name="sexComboBox" Height="38" 
                                         Foreground="Black" BorderThickness="1"
                                         FontSize="14" Padding="5">
                                    <ComboBoxItem Content="Male" Foreground="Black"/>
                                    <ComboBoxItem Content="Female" Foreground="Black"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Position -->
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="Role / Position *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <ComboBox x:Name="positionComboBox" Height="38" 
                                         Foreground="Black" BorderThickness="1"
                                         FontSize="14" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Address Section -->
                    <Border Grid.Row="3" Background="#FF0D2D2C" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Section Title -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Address Information" 
                                      Foreground="White" FontSize="16" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <!-- City/Province -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="City / Province *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="cityprovinceField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Barangay -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Barangay *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="brgyField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>

                            <!-- Street -->
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="Street *" Foreground="White" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,5"/>
                                <TextBox x:Name="streetField" Height="38" Background="#FF28666E" 
                                        Foreground="White" BorderBrush="#FF4A9EFF" BorderThickness="1"
                                        Padding="10" FontSize="12" CaretBrush="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Submit Button -->
                    <Border Grid.Row="4" Background="#FF0D2D2C" CornerRadius="10" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <Button x:Name="createEmployeeBtn" Content="CREATE EMPLOYEE" 
                                   Width="250" Height="45" Background="#FF4CAF50" 
                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                   Click="CreateEmployee_Click"
                                   BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF45A049"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="* Required fields" Foreground="#FFAAAAAA" FontSize="11" 
                                      FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF0A2236" Margin="20,10,20,10" CornerRadius="10">
            <TextBlock Text="Fill in all required fields to add a new employee" 
                      Foreground="#FFAAAAAA" FontSize="12" FontStyle="Italic"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>