<Page x:Class="erpRestaurantRevise.Pages.EmpAttendanceReports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:erpRestaurantRevise.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="900"
      Title="EmpAttendanceReports">

    <Grid Background="#FF051821">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="700"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <Label Content="Employee Attendance Records" 
                   Width="750" Foreground="White" FontSize="20"
                   HorizontalContentAlignment="Center" />
            <TextBlock Height="30"/>

            <!-- 🔍 FILTERS -->
            <WrapPanel Height="50" Width="750" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Width="200"
                         Height="30"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />

                <TextBlock Width="10"/>

                <Label Content="From:" Foreground="White" VerticalAlignment="Center"/>
                <DatePicker x:Name="StartDatePicker" Width="150" SelectedDateChanged="DatePicker_Changed"/>

                <Label Content="To:" Foreground="White" VerticalAlignment="Center"/>
                <DatePicker x:Name="EndDatePicker" Width="150" SelectedDateChanged="DatePicker_Changed"/>

                <Button Content="Clear Filters"
                        Width="100"
                        Height="30"
                        Margin="10,0,0,0"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ClearFilters_Click"/>
            </WrapPanel>

            <StackPanel Width="750" Height="500">
                <DataGrid x:Name="AttendanceDataGrid"
                          AutoGenerateColumns="False"
                          Height="460"
                          Width="750"
                          Background="White"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          IsReadOnly="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeID}" Width="100"/>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="Time In"
                                            Binding="{Binding TimeIn, StringFormat={}{0:hh\\:mm}, TargetNullValue=''}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Time Out"
                                            Binding="{Binding TimeOut, StringFormat={}{0:hh\\:mm}, TargetNullValue=''}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Hours Worked"
                    Binding="{Binding HourWorked, StringFormat={}{0:F2}, TargetNullValue='0.00'}"
                    Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Date"
                    Binding="{Binding DateToday, StringFormat=d, TargetNullValue=''}"
                    Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ✅ Added TextBlock for total hours -->
                <TextBlock x:Name="TotalHoursTextBlock"
                           Text="Total Hours: 0"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="White"
                           Margin="10,10,0,0"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
